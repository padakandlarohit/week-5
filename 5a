import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

void main() {
  runApp(
    ChangeNotifierProvider(
      create: (_) => CatalogModel(),
      child: const MyApp(),
    ),
  );
}

// Item Model
class Item {
  final int id;
  final String name;
  final String description;
  final IconData icon;
  final Color color;
  bool isFavorite;

  Item({
    required this.id,
    required this.name,
    required this.description,
    required this.icon,
    required this.color,
    this.isFavorite = false,
  });
}

// Shared App State using Provider
class CatalogModel extends ChangeNotifier {
  final List<Item> _items = [
    Item(
      id: 1,
      name: 'Laptop',
      description: 'Powerful computing device',
      icon: Icons.laptop,
      color: Colors.blue,
    ),
    Item(
      id: 2,
      name: 'Mobile',
      description: 'Smartphone for everyday use',
      icon: Icons.phone_android,
      color: Colors.green,
    ),
    Item(
      id: 3,
      name: 'Headphones',
      description: 'Enjoy high-quality audio',
      icon: Icons.headphones,
      color: Colors.orange,
    ),
    Item(
      id: 4,
      name: 'Camera',
      description: 'Capture beautiful moments',
      icon: Icons.camera_alt,
      color: Colors.purple,
    ),
    Item(
      id: 5,
      name: 'Watch',
      description: 'Track time in style',
      icon: Icons.watch,
      color: Colors.red,
    ),
    Item(
      id: 6,
      name: 'Tablet',
      description: 'Portable entertainment device',
      icon: Icons.tablet,
      color: Colors.teal,
    ),
  ];

  List<Item> get items => List.unmodifiable(_items);

  int get favoriteCount =>
      _items.where((item) => item.isFavorite).length;

  void toggleFavorite(int id) {
    final item = _items.firstWhere((item) => item.id == id);
    item.isFavorite = !item.isFavorite;
    notifyListeners();
  }
}

// Main Application
class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Responsive Catalog',
      theme: ThemeData(
        colorSchemeSeed: Colors.indigo,
        useMaterial3: true,
      ),
      home: const CatalogPage(),
    );
  }
}

// Responsive Page
class CatalogPage extends StatelessWidget {
  const CatalogPage({super.key});

  @override
  Widget build(BuildContext context) {
    final favoriteCount =
        context.watch<CatalogModel>().favoriteCount;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Product Catalog'),
        backgroundColor: Colors.indigo,
        foregroundColor: Colors.white,
        actions: [
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 16),
            child: Row(
              children: [
                const Icon(Icons.favorite, color: Colors.redAccent),
                const SizedBox(width: 6),
                Text(
                  '$favoriteCount',
                  style: const TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
      body: LayoutBuilder(
        builder: (context, constraints) {
          final width = constraints.maxWidth;

          if (width >= 1024) {
            return const DesktopLayout();
          } else if (width >= 600) {
            return const TabletLayout();
          } else {
            return const MobileLayout();
          }
        },
      ),
    );
  }
}

// Reusable Item Card
class ItemCard extends StatelessWidget {
  final Item item;
  final bool compact;

  const ItemCard({
    super.key,
    required this.item,
    this.compact = false,
  });

  @override
  Widget build(BuildContext context) {
    final catalog = context.watch<CatalogModel>();

    // Find the latest item state after Provider notifications.
    final currentItem =
        catalog.items.firstWhere((element) => element.id == item.id);

    return Card(
      elevation: 3,
      margin: const EdgeInsets.all(8),
      child: Padding(
        padding: EdgeInsets.all(compact ? 10 : 16),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              currentItem.icon,
              size: compact ? 36 : 48,
              color: currentItem.color,
            ),
            const SizedBox(height: 10),
            Text(
              currentItem.name,
              textAlign: TextAlign.center,
              style: const TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 6),
            Flexible(
              child: Text(
                currentItem.description,
                textAlign: TextAlign.center,
                overflow: TextOverflow.ellipsis,
                maxLines: 3,
              ),
            ),
            IconButton(
              tooltip: currentItem.isFavorite
                  ? 'Remove from favorites'
                  : 'Add to favorites',
              icon: Icon(
                currentItem.isFavorite
                    ? Icons.star
                    : Icons.star_border,
                color: currentItem.isFavorite
                    ? Colors.amber
                    : Colors.grey,
                size: 30,
              ),
              onPressed: () {
                context.read<CatalogModel>().toggleFavorite(
                      currentItem.id,
                    );
              },
            ),
          ],
        ),
      ),
    );
  }
}

// Mobile Layout: Single Column
class MobileLayout extends StatelessWidget {
  const MobileLayout({super.key});

  @override
  Widget build(BuildContext context) {
    final items = context.watch<CatalogModel>().items;

    return ListView.builder(
      padding: const EdgeInsets.all(8),
      itemCount: items.length,
      itemBuilder: (context, index) {
        return SizedBox(
          height: 190,
          child: ItemCard(
            item: items[index],
            compact: true,
          ),
        );
      },
    );
  }
}

// Tablet Layout: Two Column Grid
class TabletLayout extends StatelessWidget {
  const TabletLayout({super.key});

  @override
  Widget build(BuildContext context) {
    final items = context.watch<CatalogModel>().items;

    return GridView.builder(
      padding: const EdgeInsets.all(12),
      itemCount: items.length,
      gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: 2,
        crossAxisSpacing: 12,
        mainAxisSpacing: 12,
        childAspectRatio: 1.15,
      ),
      itemBuilder: (context, index) {
        return ItemCard(item: items[index]);
      },
    );
  }
}

// Desktop Layout: NavigationRail + Three Column Grid
class DesktopLayout extends StatelessWidget {
  const DesktopLayout({super.key});

  @override
  Widget build(BuildContext context) {
    final items = context.watch<CatalogModel>().items;
    final favoriteCount =
        context.watch<CatalogModel>().favoriteCount;

    return Row(
      children: [
        NavigationRail(
          selectedIndex: 0,
          onDestinationSelected: (_) {},
          labelType: NavigationRailLabelType.all,
          leading: Padding(
            padding: const EdgeInsets.symmetric(vertical: 16),
            child: Column(
              children: [
                const Icon(
                  Icons.favorite,
                  color: Colors.red,
                  size: 28,
                ),
                Text(
                  '$favoriteCount',
                  style: const TextStyle(
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
          ),
          destinations: const [
            NavigationRailDestination(
              icon: Icon(Icons.home),
              label: Text('Home'),
            ),
            NavigationRailDestination(
              icon: Icon(Icons.shopping_bag),
              label: Text('Products'),
            ),
            NavigationRailDestination(
              icon: Icon(Icons.settings),
              label: Text('Settings'),
            ),
          ],
        ),
        const VerticalDivider(width: 1),
        Expanded(
          child: Column(
            children: [
              Expanded(
                child: GridView.builder(
                  padding: const EdgeInsets.all(16),
                  itemCount: items.length,
                  gridDelegate:
                      const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 3,
                    crossAxisSpacing: 12,
                    mainAxisSpacing: 12,
                    childAspectRatio: 1.1,
                  ),
                  itemBuilder: (context, index) {
                    return ItemCard(item: items[index]);
                  },
                ),
              ),
              const CounterWidget(),
            ],
          ),
        ),
      ],
    );
  }
}

// Local State using StatefulWidget and setState()
class CounterWidget extends StatefulWidget {
  const CounterWidget({super.key});

  @override
  State<CounterWidget> createState() => _CounterWidgetState();
}

class _CounterWidgetState extends State<CounterWidget> {
  int counter = 0;

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(12),
      color: Colors.indigo.shade50,
      child: Row(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          const Text(
            'Local Counter:',
            style: TextStyle(
              fontSize: 16,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(width: 12),
          Text(
            '$counter',
            style: const TextStyle(
              fontSize: 18,
              color: Colors.indigo,
            ),
          ),
          const SizedBox(width: 12),
          ElevatedButton(
            onPressed: () {
              setState(() {
                counter++;
              });
            },
            child: const Text('Increment'),
          ),
        ],
      ),
    );
  }
}
